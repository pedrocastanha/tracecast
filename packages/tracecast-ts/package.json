{
  "name": "tracecast",
  "version": "0.1.2",
  "description": "LLM observability SDK — framework-agnostic tracing for AI applications",
  "license": "MIT",
  "author": "Pedro Castanheira Costa",
  "homepage": "https://github.com/pedrocastanha/tracecast",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrocastanha/tracecast.git",
    "directory": "packages/tracecast-ts"
  },
  "bugs": {
    "url": "https://github.com/pedrocastanha/tracecast/issues"
  },
  "keywords": [
    "llm",
    "observability",
    "tracing",
    "langchain",
    "openai",
    "anthropic"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./integrations/langchain": {
      "import": "./dist/integrations/langchain.js",
      "require": "./dist/integrations/langchain.js",
      "types": "./dist/integrations/langchain.d.ts"
    },
    "./exporters/jsonFile": {
      "import": "./dist/exporters/jsonFile.js",
      "require": "./dist/exporters/jsonFile.js",
      "types": "./dist/exporters/jsonFile.d.ts"
    },
    "./core/costCalculator": {
      "import": "./dist/core/costCalculator.js",
      "require": "./dist/core/costCalculator.js",
      "types": "./dist/core/costCalculator.d.ts"
    },
    "./exporters/mongo": {
      "import": "./dist/exporters/mongoExporter.js",
      "require": "./dist/exporters/mongoExporter.js",
      "types": "./dist/exporters/mongoExporter.d.ts"
    },
    "./exporters/postgres": {
      "import": "./dist/exporters/postgresExporter.js",
      "require": "./dist/exporters/postgresExporter.js",
      "types": "./dist/exporters/postgresExporter.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --passWithNoTests",
    "prepublishOnly": "npm run build && npm test"
  },
  "optionalDependencies": {
    "@langchain/core": "^0.3",
    "mongodb": "^6",
    "pg": "^8"
  },
  "peerDependencies": {
    "mongodb": ">=5",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@langchain/langgraph": "^1.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.18.0",
    "dotenv": "^16.6.1",
    "jest": "^29",
    "mongodb": "^7.1.0",
    "openai": "^6.27.0",
    "ts-jest": "^29",
    "typescript": "^5.3"
  }
}
